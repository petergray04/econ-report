{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petergray04/econ-report/schema/edition.schema.json",
  "title": "U.S. Economic Indicators — weekly edition",
  "description": "One edition = one file data/<YYYY-MM-DD>.json. Feeds both the 2-page PDF and the web page. Drafts (status: draft) may carry needs_review flags; published editions may not (enforced by econ/validate.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["edition", "edition_label", "data_through", "sections", "kpis", "gdp", "imf", "ms",
               "markets", "watch", "story", "consensus_policy", "actuals_policy"],
  "properties": {
    "edition": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "edition_label": {"type": "string", "minLength": 1},
    "data_through": {"type": "string", "minLength": 1},
    "status": {"const": "draft", "description": "Present only on auto-generated drafts awaiting review."},
    "draft_meta": {"type": "object", "description": "Written by the Monday draft job (what changed, what needs review). Removed on publish."},
    "sections": {
      "type": "array",
      "description": "Exactly five, in order: Labor, Personal/Household, Industrial & Manufacturing, Housing, Inflation (the PDF layout places 3 on page 1 and 2 on page 2).",
      "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "rows"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
        }
      }
    },
    "kpis": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "value", "tone", "detail"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "tone": {"enum": ["up", "dn", ""]},
          "detail": {"type": "string"}
        }
      }
    },
    "gdp": {
      "type": "object", "additionalProperties": false,
      "required": ["years", "gdpnow", "note", "ulc", "eci"],
      "properties": {
        "years": {
          "type": "object",
          "propertyNames": {"pattern": "^\\d{4}$"},
          "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/numOrNull"}}
        },
        "gdpnow": {
          "type": "object", "additionalProperties": false, "required": ["q", "value"],
          "properties": {"q": {"type": "string"}, "value": {"type": "number"}}
        },
        "note": {"type": "string"},
        "ulc": {"type": "object", "additionalProperties": {"type": "number"}},
        "eci": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "imf": {
      "type": "object", "additionalProperties": false, "required": ["edition", "rows"],
      "properties": {
        "edition": {"type": "string", "minLength": 1},
        "rows": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}
        }
      }
    },
    "ms": {
      "type": "object", "additionalProperties": false,
      "required": ["sp_ye26", "sp_mid27", "eps26", "eps27", "pe", "asof", "note"],
      "properties": {
        "sp_ye26": {"type": "string"}, "sp_mid27": {"type": "string"},
        "eps26": {"type": "string"}, "eps27": {"type": "string"}, "pe": {"type": "string"},
        "asof": {"type": "string"},
        "note": {"type": "string", "pattern": "confirm against internal research before client use",
                 "description": "Morgan Stanley figures are public press only; the caveat is mandatory."}
      }
    },
    "markets": {
      "type": "object", "additionalProperties": false, "required": ["rows", "rates", "note"],
      "properties": {
        "rows": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "minItems": 4, "maxItems": 4,
                    "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "number"}, {"type": "number"}]}
        },
        "rates": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "minItems": 3, "maxItems": 3,
                    "prefixItems": [{"type": "string"}, {"type": "number"}, {"type": "number"}]}
        },
        "note": {"type": "string"}
      }
    },
    "watch": {
      "type": "array",
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
    },
    "story": {"type": "string", "minLength": 1},
    "consensus_policy": {"type": "string", "minLength": 1},
    "actuals_policy": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "numOrNull": {"type": ["number", "null"]},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["period", "cons", "act"],
      "properties": {
        "period": {"type": "string", "minLength": 1},
        "cons": {"$ref": "#/$defs/numOrNull", "description": "Consensus. null = no public consensus (rendered '—'). Never estimated."},
        "act": {"$ref": "#/$defs/numOrNull", "description": "First print. null only allowed in drafts."}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "p1", "p2", "fmt", "better", "note", "src", "url", "sub"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "p1": {"$ref": "#/$defs/release", "description": "Prior release"},
        "p2": {"$ref": "#/$defs/release", "description": "Latest release"},
        "fmt": {"enum": ["k", "pct", "pct1", "pct2", "int", "idx", "b", "m"]},
        "better": {"enum": ["higher", "lower", "none"]},
        "note": {"type": "string"},
        "src": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://\\S+$"},
        "sub": {"type": "boolean"},
        "needs_review": {"type": "boolean", "description": "Set by the Monday draft job; must be removed before publishing."},
        "review": {"type": "array", "items": {"type": "string"}, "description": "What needs checking on this row (draft only)."}
      }
    }
  }
}
